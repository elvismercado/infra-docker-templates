# General
TZ=Europe/London
UID=99
GID=100
UMASK=022

CONTAINER_NAME=vaultwarden
IMAGE_VERSION=latest
VOLUMES_BASE=/mnt/user/appdata
SUBNET=10.42.0.0/24
HTTP_PORT=11001

# Vaultwarden core settings
DOMAIN=https://vaultwarden.example.com
# Leave ADMIN_TOKEN empty to disable the admin panel.
# Generate an Argon2 PHC string with: docker run --rm -it vaultwarden/server:latest /vaultwarden hash
ADMIN_TOKEN=

# Vaultwarden policy
SENDS_ALLOWED=true
HIBP_API_KEY=
ORG_ATTACHMENT_LIMIT=97280
USER_ATTACHMENT_LIMIT=97280
USER_SEND_LIMIT=97280
TRASH_AUTO_DELETE_DAYS=30
SIGNUPS_ALLOWED=false
SIGNUPS_VERIFY=true
INVITATIONS_ALLOWED=false
INVITATION_ORG_NAME=Vaultwarden
PASSWORD_ITERATIONS=1200000
EXPERIMENTAL_CLIENT_FEATURE_FLAGS=
REQUIRE_DEVICE_EMAIL=true
EXTENDED_LOGGING=false

# Email
SMTP_HOST=smtp.gmail.com
SMTP_FROM=
SMTP_FROM_NAME=Vaultwarden
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
SMTP_PORT=587

# Mobile push notifications
PUSH_ENABLED=false
PUSH_INSTALLATION_ID=
PUSH_INSTALLATION_KEY=
PUSH_RELAY_URI=https://push.bitwarden.com
PUSH_IDENTITY_URI=https://identity.bitwarden.com
# EU installations use https://api.bitwarden.eu and https://identity.bitwarden.eu.

# Backup (BackVault)
BACKVAULT_IMAGE_VERSION=latest
BACKVAULT_PORT=8081
BACKVAULT_SERVER=http://vaultwarden:80
BACKUP_ENCRYPTION_MODE=raw
BACKUP_INTERVAL_HOURS=12
RETAIN_DAYS=30
# Use 0 only when BACKVAULT_SERVER uses HTTPS with a self-signed certificate.
NODE_TLS_REJECT_UNAUTHORIZED=1

# Optional Watchtower override
WATCHTOWER_ENABLE=false