# General
TZ=Europe/London

UID=99
GID=100

CONTAINER_NAME=wud
VOLUMES_BASE=/mnt/user/appdata
SUBNET=

HTTP_PORT=3000
DOCKER_SOCK=/var/run/docker.sock

# Watcher
WUD_CRON=0 */6 * * *

# SMTP (Gmail)
# Primary transport: port 587 with STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=
SMTP_TO=
WUD_TLS_ENABLED=false

# Alternative transport: port 465 with implicit TLS.
# SMTP_PORT=465
# WUD_TLS_ENABLED=true

# When deployed through Ansible, the role derives WUD_TLS_ENABLED from the
# global smtp_security value. Use a WUD-specific override only when WUD needs
# a different port or transport from the host's global SMTP configuration.
