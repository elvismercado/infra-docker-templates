TZ=Europe/London

UID=99
GID=100
UMASK=022

CONTAINER_NAME=ferdium-server
IMAGE_VERSION=latest
VOLUMES_BASE=/mnt/user/appdata
SUBNET=10.42.0.0/24
HTTP_PORT=3333

# Application settings
NODE_ENV=production
APP_URL=http://127.0.0.1
IS_CREATION_ENABLED=true
IS_DASHBOARD_ENABLED=true
IS_REGISTRATION_ENABLED=true
CONNECT_WITH_FRANZ=false
DATA_DIR=/data
JWT_USE_PEM=true

# Mail / SMTP settings (optional, used for password resets and invitation emails)
# For port 587 (STARTTLS): MAIL_SSL=false, MAIL_REQUIRE_TLS=true
# For port 465 (SSL/TLS): MAIL_SSL=true, MAIL_REQUIRE_TLS=false
MAIL_CONNECTION=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
MAIL_SSL=false
MAIL_REQUIRE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Note: Container automatically runs database migrations on startup. Back up data directory (sqlite DB) before updates.
