TZ=Europe/London

UID=99
GID=100

CONTAINER_NAME=dashy
IMAGE_VERSION=latest
VOLUMES_BASE=/mnt/user/appdata
SUBNET=10.42.0.0/24
HTTP_PORT=8080

# WUD (What's Up Docker?) integration
# The Ansible Dashy role includes docker-compose.wud.yml when enable_wud=true
# is set in the host's Dashy config. Direct Compose users must include the
# overlay explicitly with: docker compose -f docker-compose.yml -f docker-compose.wud.yml up -d