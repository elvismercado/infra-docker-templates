# Host and Compose
TZ=Europe/Amsterdam
UID=99
GID=100
UMASK=022

VOLUMES_BASE=/mnt/user/appdata
CONTAINER_NAME=vrising
# Leave empty to use 10.42.0.0/24.
SUBNET=

# Container and SteamCMD
IMAGE_VERSION=vrising
GAME_ID=1829350
VALIDATE=false
ENABLE_BEPINEX=false

# Server identity
SERVER_NAME='V Rising Friends'
SERVER_DESCRIPTION='Private server for friends'
WORLD_NAME=friends-world

# Required: replace this before running scripts/setup.sh.
# Keep values containing spaces or shell characters single-quoted.
SERVER_PASSWORD='CHANGE_ME'

# Networking
GAME_PORT=9876
QUERY_PORT=9877
HIDE_IP_ADDRESS=true
LIST_ON_STEAM=true
LIST_ON_EOS=true

# Private PvE defaults
GAME_SETTINGS_PRESET=StandardPvE
# Optional V Rising 1.1 host overrides. Leave these commented to use the
# server's shipped defaults. These use the official VR_* names intentionally.
# VR_DIFFICULTY_PRESET=Difficulty_Normal
# VR_AUTOSAVESMARTKEEP='10:1:1,30:0:1,60:0:1,120:0:1,360:0:1,1440:0:1,52560000:99:0'
# VR_LAN_MODE=false
# Set 0 to disable scheduled world resets. DAY_OF_RESET accepts Any or a
# weekday name.
# VR_RESET_DAYS_INTERVAL=0
# VR_DAY_OF_RESET=Any
# Reconnect time is in seconds; slots are reserved for recently disconnected
# players.
# VR_SAFE_RECONNECT_TIME=300
# VR_SAFE_RECONNECT_SLOTS=10
MAX_CONNECTED_USERS=10
MAX_CONNECTED_ADMINS=4
# In-game admins. Space-, comma-, or newline-separated steamID64 values (each 17
# digits). When set, adminlist.txt is regenerated on every container start and
# hot-reloads live. Leave empty to manage adminlist.txt by hand instead.
ADMIN_STEAM_IDS=
SERVER_FPS=30
LOWER_FPS_WHEN_EMPTY=true
LOWER_FPS_WHEN_EMPTY_VALUE=5
SECURE=true
AUTO_SAVE_COUNT=30
AUTO_SAVE_INTERVAL=120

# RCON is disabled by default. When enabled, scripts automatically add the RCON
# Compose override and publish TCP only on host loopback. Use a specific private
# LAN address only when another trusted host needs access; never expose it on WAN.
RCON_ENABLED=false
RCON_HOST_ADDRESS=127.0.0.1
RCON_BIND_ADDRESS=0.0.0.0
RCON_PORT=25575
RCON_PASSWORD='CHANGE_ME'

# Maintenance
BACKUP_RETENTION=14
# Enable the matching docker-compose overlay when the stack is deployed with it,
# so setup/backup/restore/update recreate the container with the same labels.
WATCHTOWER_ENABLE=false
WUD_ENABLE=false
