# Host and Compose
TZ=Europe/Amsterdam
UID=99
GID=100

VOLUMES_BASE=/mnt/user/appdata
CONTAINER_NAME=pelican
# Leave empty to use 10.42.0.0/24 and 10.42.1.0/24.
PANEL_SUBNET=
WINGS_SUBNET=

# Images
PANEL_VERSION=v1.0.0-beta35
WINGS_VERSION=v1.0.0-beta26
MARIADB_VERSION=10.11
REDIS_VERSION=alpine

# Panel
# Replace localhost with the LAN address or hostname used by browsers and Wings.
# For direct HTTP, the APP_URL port must match PANEL_HTTP_PORT.
# Panel health means that Caddy and PHP-FPM are responding. It does not mean the
# installer has completed, migrations are current, or an administrator exists.
APP_URL=http://localhost:8080
APP_ENV=production
APP_DEBUG=false
PANEL_HTTP_PORT=8080
MAIL_MAILER=log

# Database
DB_NAME=panel
DB_USER=pelican
# Required: replace both values before the first start. Enter DB_PASSWORD in
# the Panel installer. DB_ROOT_PASSWORD is only for MariaDB administration.
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# Wings
# Leave COMPOSE_PROFILES empty until wings/config/config.yml exists.
# Use a first pass with Wings disabled, complete Panel installation, create the
# node, save its generated config, then enable the wings profile on the second pass.
COMPOSE_PROFILES=
WINGS_API_PORT=8081
WINGS_SFTP_PORT=2022
WINGS_USERNAME=pelican

# Docker socket access grants Wings near-root access to the host.
DOCKER_SOCK=/var/run/docker.sock
DOCKER_CONTAINERS_PATH=/var/lib/docker/containers
SSL_CERTS_PATH=/etc/ssl/certs
